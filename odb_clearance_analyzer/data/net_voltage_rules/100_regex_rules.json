{
  "rules": [
    {
      "rule_id": "hv_numeric_voltage",
      "priority": 930,
      "enabled": true,
      "pattern": "(?:^|_)(?:HV|HV_BUS|VBUS_HV|DC_LINK|DCLINK|PFC|BULK|RECT|VBOOST)_?(?P<voltage>\\d+V\\d*|\\d+V|\\d{3,4})(?:$|_)",
      "match_type": "regex",
      "match_on": "normalized",
      "net_class": "HIGH_VOLTAGE",
      "voltage_v": "",
      "reference_net": "best_ground",
      "voltage_type": "DC",
      "confidence": "High",
      "severity": "Critical",
      "reason": "Parsed numeric high-voltage token",
      "warning": "High-voltage net requires review"
    },
    {
      "rule_id": "hv_hint",
      "priority": 920,
      "enabled": true,
      "pattern": "(?:^|_)(?:HV|HV_BUS|VBUS_HV|DC_LINK|DCLINK|PFC|BULK|RECT|VBOOST)(?:$|_)",
      "match_type": "regex",
      "match_on": "normalized",
      "net_class": "HIGH_VOLTAGE",
      "voltage_v": "",
      "reference_net": "best_ground",
      "voltage_type": "DC",
      "confidence": "Medium",
      "severity": "Critical",
      "reason": "High-voltage name hint found",
      "warning": "High-voltage net requires manual voltage confirmation"
    },
    {
      "rule_id": "positive_voltage_token",
      "priority": 850,
      "enabled": true,
      "pattern": "(?:^|_)(?:P|VCC|VDD|VDDA|VDDD|AVDD|DVDD|IOVDD)?_?(?P<voltage>\\d+V\\d*|\\d+V)(?:$|_)",
      "match_type": "regex",
      "match_on": "normalized",
      "net_class": "POWER",
      "voltage_v": "",
      "reference_net": "best_ground",
      "voltage_type": "DC",
      "confidence": "High",
      "severity": "Info",
      "reason": "Parsed explicit numeric voltage token",
      "warning": ""
    },
    {
      "rule_id": "negative_voltage_token",
      "priority": 1100,
      "enabled": true,
      "pattern": "(?:^|[_+\\-])(?:-|M|N|NEG)(?P<voltage>\\d+V\\d*|\\d+V)(?:$|[_+\\-])",
      "match_type": "regex",
      "match_on": "raw",
      "net_class": "POWER_NEGATIVE",
      "voltage_v": "",
      "reference_net": "GND",
      "voltage_type": "DC",
      "confidence": "High",
      "severity": "Review",
      "reason": "Parsed explicit negative voltage token",
      "warning": "Confirm negative rail voltage"
    },
    {
      "rule_id": "battery_cell_count",
      "priority": 900,
      "enabled": true,
      "pattern": "(?:^|_)(?:BAT|PACK)_(?P<cells>\\d+)S(?:$|_)",
      "match_type": "regex",
      "match_on": "normalized",
      "net_class": "BATTERY",
      "voltage_v": "",
      "cell_count_from_pattern": true,
      "volts_per_cell": "",
      "reference_net": "best_ground",
      "voltage_type": "DC",
      "confidence": "Medium",
      "severity": "Warning",
      "reason": "Parsed battery cell count using max cell voltage",
      "warning": "Confirm actual battery pack maximum voltage"
    }
  ]
}
